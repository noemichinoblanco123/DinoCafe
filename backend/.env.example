# Copia este archivo como .env si quieres cambiar la configuración.
# Sin variables, el backend usa SQLite (backend/db.sqlite3) y queda listo para probar.

DJANGO_SECRET_KEY=dev-insegura-solo-para-pruebas-dinocafe-ingenieria-software-2026
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# Para PostgreSQL local:
# DB_ENGINE=postgres
# POSTGRES_DB=cafeteria_bd
# POSTGRES_USER=dinocafe
# POSTGRES_PASSWORD=dinocafe
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Para Docker Compose, configura estas mismas variables en el archivo .env
# de la raíz del repositorio (ver ../.env.example).
